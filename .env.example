DATABASE_URL="postgresql://outpost:outpost@localhost:5433/outpost?schema=public"

# Generate with: npx auth secret
# or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# ── Payments (Phase 5) ────────────────────────────────────────────────────────
# Pay-per-order only: one payment authorises one order. No stored balance.
#
# Routing is by the advertiser's billing country, resolved once at placement:
#   IN            -> Razorpay
#   everywhere else -> Stripe
#
# With no keys set, the registry falls back to the built-in fake provider, so
# the app and the whole test suite run without a payment account. Nothing in
# fake mode moves money.

# Stripe test keys: https://dashboard.stripe.com/test/apikeys
# The webhook secret comes from `stripe listen` or the dashboard endpoint.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Razorpay test keys: https://dashboard.razorpay.com/app/website-app-settings/api-keys
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Forces the fake provider even when real keys are present. The test suite sets
# this so a stray key can never cause a test run to touch a real account.
PAYMENTS_FORCE_FAKE="true"

# Where generated invoice PDFs are written. They are stored, never re-rendered.
INVOICE_DIR=""

# ── Monitoring (Phase 6) ──────────────────────────────────────────────────────
# Shared secret for the cron routes. Without it they fail closed and 404 —
# these endpoints spend money and fetch third-party pages.
CRON_SECRET=""

# DataForSEO. Without credentials the refresh reports failure and keeps the last
# known metrics, rather than zeroing them or hiding the site.
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""

# Daily spend cap for metrics lookups, in minor units. Hitting it halts further
# lookups and alerts; it never stops silently.
METRICS_DAILY_CAP_MINOR="5000"
METRICS_COST_PER_LOOKUP_MINOR="10"

# PayPal — used for EU and UK billing countries.
# Sandbox credentials: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
# "live" switches to the production API. Anything else stays on sandbox, so a
# missing value cannot accidentally point at real money.
PAYPAL_ENV="sandbox"
